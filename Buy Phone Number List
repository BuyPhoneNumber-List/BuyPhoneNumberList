    <div class='container'>

      <div class='cta'>

        <h2>
          Explore Our Database Resources
        </h2>

        <p>
          Browse the available categories and discover
          useful information from our website.
        </p>

        <a class='btn btn-primary' href='/p/phone-number-list.html'>
          Get Started
        </a>

      </div>

    </div>
  </section>


  <!-- FOOTER -->

  <footer>

    <div class='container'>

      <div class='footer-grid'>

        <div>
          <h3>PhoneList</h3>
          <p>
