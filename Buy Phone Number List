    height:auto;
}

/* =========================================================
   VARIABLES
========================================================= */

:root{
    --primary:#2563eb;
    --primary-dark:#1d4ed8;
    --secondary:#0f172a;
    --text:#334155;
    --muted:#64748b;
    --light:#f8fafc;
    --white:#ffffff;
    --border:#e2e8f0;
    --success:#059669;

    --shadow:
    0 20px 60px rgba(15,23,42,.08);

    --radius:20px;
}

/* =========================================================
   CONTAINER
========================================================= */

.container{
    width:min(1180px,92%);
    margin:auto;
}

/* =========================================================
   HEADER
========================================================= */

.header{
    position:sticky;
    top:0;
    z-index:9999;

    background:rgba(255,255,255,.95);

    backdrop-filter:blur(15px);

    border-bottom:1px solid var(--border);
}

.navbar{
    min-height:76px;

    display:flex;
    align-items:center;
    justify-content:space-between;

    gap:25px;
}

.logo{
    font-size:26px;
    font-weight:900;

    letter-spacing:-1px;

    color:var(--secondary);
}

.logo span{
    color:var(--primary);
}

.nav-links{
    display:flex;
    align-items:center;

    gap:3px;
}

.nav-links a{
    padding:9px 12px;

    color:#475569;

    font-size:13px;

    font-weight:800;

    border-radius:10px;

    transition:.25s;
}

.nav-links a:hover{
    color:var(--primary);

    background:#eff6ff;
}

.mobile-menu{
    display:none;

    width:43px;
    height:43px;

    border:0;

    border-radius:10px;

    background:#eff6ff;

    color:var(--primary);

    font-size:22px;

    cursor:pointer;
}

/* =========================================================
   HERO
========================================================= */

.hero{
    position:relative;

    overflow:hidden;

    padding:100px 0 90px;

    background:

    radial-gradient(
        circle at 10% 20%,
        rgba(37,99,235,.13),
        transparent 30%
    ),

    radial-gradient(
        circle at 90% 10%,
        rgba(14,165,233,.13),
        transparent 30%
    ),

    linear-gradient(
        180deg,
        #f8fbff 0%,
        #ffffff 100%
    );
}

.hero-grid{
    display:grid;

    grid-template-columns:
    1.15fr
    .85fr;

    gap:60px;

    align-items:center;
}

.badge{
    display:inline-flex;

    align-items:center;

    gap:8px;

    padding:7px 14px;

    background:#eff6ff;

    color:#1d4ed8;

    border:1px solid #bfdbfe;

    border-radius:50px;

    font-size:12px;

    font-weight:900;

    margin-bottom:20px;
}

.hero h1{
    color:var(--secondary);

    font-size:
    clamp(
        40px,
        6vw,
        68px
    );

    line-height:1.04;

    letter-spacing:-3px;

    margin-bottom:22px;
}

.hero h1 span{
    color:var(--primary);
}

.hero-description{
    max-width:690px;

    color:var(--muted);

    font-size:18px;

    margin-bottom:30px;
}

.hero-buttons{
    display:flex;

    flex-wrap:wrap;

    gap:13px;
}

.btn{
    min-height:48px;

    display:inline-flex;

    align-items:center;

    justify-content:center;

    gap:8px;

    padding:0 21px;

    border-radius:12px;

    font-size:14px;

    font-weight:900;

    transition:.25s;
}

.btn-primary{
    background:var(--primary);

    color:#ffffff;

    box-shadow:
    0 12px 30px
    rgba(37,99,235,.25);
}

.btn-primary:hover{
    background:var(--primary-dark);

    transform:translateY(-2px);
}

.btn-outline{
    border:1px solid var(--border);

    background:#ffffff;

    color:var(--secondary);
}

.btn-outline:hover{
    border-color:#93c5fd;

    color:var(--primary);
}

/* =========================================================
   HERO DATA CARD
========================================================= */

.hero-card{
    padding:28px;

    background:rgba(255,255,255,.92);

    border:1px solid var(--border);

    border-radius:26px;

    box-shadow:var(--shadow);
}

.hero-card-head{
    display:flex;

    justify-content:space-between;

    align-items:center;

    margin-bottom:20px;
}

.hero-card-title{
    color:var(--secondary);

    font-size:16px;

    font-weight:900;
}

.status{
    display:flex;

    align-items:center;

    gap:6px;

    color:var(--success);

    font-size:11px;

    font-weight:900;
}

.status-dot{
    width:8px;
    height:8px;

    background:#10b981;

    border-radius:50%;
}

.data-item{
    display:flex;

    align-items:center;

    gap:14px;

    padding:15px 0;

    border-bottom:1px solid #edf2f7;
}

.data-item:last-child{
    border-bottom:0;
}

.data-icon{
    width:44px;
    height:44px;

    display:grid;

    place-items:center;

    background:#eff6ff;

    border-radius:13px;

    font-size:20px;
}

.data-text{
    flex:1;
}

.data-text strong{
    display:block;

    color:var(--secondary);

    font-size:14px;
}

.data-text small{
    color:var(--muted);

    font-size:12px;
}

.arrow{
    color:#94a3b8;

    font-size:18px;
}

/* =========================================================
   SECTION
========================================================= */

.section{
    padding:90px 0;
}

.section-head{
    max-width:760px;

    margin:
    0 auto
    48px;

    text-align:center;
}

.eyebrow{
    color:var(--primary);

    font-size:12px;

    font-weight:900;

    text-transform:uppercase;

    letter-spacing:1.5px;
}

.section-head h2{
    margin:8px 0 14px;

    color:var(--secondary);

    font-size:
    clamp(
        30px,
        4vw,
        46px
    );

    line-height:1.15;

    letter-spacing:-1.5px;
}

.section-head p{
    color:var(--muted);
}

/* =========================================================
   DATABASE CARDS
========================================================= */

.database-grid{
    display:grid;

    grid-template-columns:
    repeat(3,1fr);

    gap:20px;
}

.database-card{
    padding:28px;

    background:#ffffff;

    border:1px solid var(--border);

    border-radius:var(--radius);

    transition:.3s;
}

.database-card:hover{
    transform:translateY(-6px);

    border-color:#bfdbfe;

    box-shadow:var(--shadow);
}

.card-icon{
    width:55px;
    height:55px;

    display:grid;

    place-items:center;

    background:#eff6ff;

    color:var(--primary);

    border-radius:15px;

    font-size:24px;

    margin-bottom:20px;
}

.database-card h3{
    color:var(--secondary);

    font-size:21px;

    line-height:1.3;

    margin-bottom:9px;
}

.database-card p{
    color:var(--muted);

    font-size:14px;

    margin-bottom:20px;
}

.card-link{
    color:var(--primary);

    font-size:13px;

    font-weight:900;
}

/* =========================================================
   FEATURES
========================================================= */

.light-section{
    background:#f8fafc;
}

.features{
    display:grid;

    grid-template-columns:
    repeat(3,1fr);

    gap:20px;
}

.feature{
    padding:30px 22px;

    text-align:center;
}

.feature-icon{
    width:60px;
    height:60px;

    display:grid;

    place-items:center;

    margin:
    0 auto
    18px;

    background:#eff6ff;

    border-radius:50%;

    font-size:25px;
}

.feature h3{
    color:var(--secondary);

    margin-bottom:8px;
}

.feature p{
    color:var(--muted);

    font-size:14px;
}

/* =========================================================
   ABOUT
========================================================= */

.about-grid{
    display:grid;

    grid-template-columns:
    1fr
    1fr;

    gap:55px;

    align-items:center;
}

.about-content h2{
    color:var(--secondary);

    font-size:42px;

    line-height:1.15;

    letter-spacing:-1.5px;

    margin:8px 0 18px;
}

.about-content p{
    color:var(--muted);

    margin-bottom:15px;
}

.check-list{
    display:grid;

    gap:11px;

    margin-top:22px;
}

.check-item{
    display:flex;

    gap:10px;

    color:#475569;

    font-weight:750;
}

.check{
    color:var(--success);

    font-weight:900;
}

.about-card{
    padding:35px;

    border-radius:25px;

    background:
    linear-gradient(
        145deg,
        #eff6ff,
        #f8fafc
    );

    border:1px solid #dbeafe;
}

.stats{
    display:grid;

    grid-template-columns:
    1fr
    1fr;

    gap:15px;
}

.stat{
    padding:25px;

    background:#ffffff;

    border:1px solid var(--border);

    border-radius:17px;
}

.stat strong{
    display:block;

    color:var(--primary);

    font-size:27px;
}

.stat span{
    color:var(--muted);

    font-size:13px;
}

/* =========================================================
   FAQ
========================================================= */

.faq{
    max-width:850px;

    margin:auto;
}

.faq-item{
    overflow:hidden;

    margin-bottom:12px;

    background:#ffffff;

    border:
    1px solid
    var(--border);

    border-radius:14px;
}

.faq-question{
    width:100%;

    padding:19px 20px;

    border:0;

    background:#ffffff;

    color:var(--secondary);

    display:flex;

    justify-content:space-between;

    text-align:left;

    font-size:15px;

    font-weight:900;

    cursor:pointer;
}

.faq-answer{
    display:none;

    padding:
    0
    20px
    20px;

    color:var(--muted);

    font-size:14px;
}

.faq-item.active .faq-answer{
    display:block;
}

.faq-symbol{
    transition:.25s;
}

.faq-item.active .faq-symbol{
    transform:rotate(45deg);
}

/* =========================================================
   CONTACT
========================================================= */

.contact-section{
    padding:90px 0;
}

.contact-box{
    display:grid;

    grid-template-columns:
    1fr
    .8fr;

    gap:50px;

    padding:55px;

    color:#ffffff;

    background:#020617;

    border-radius:28px;
}

.contact-box h2{
    font-size:40px;

    line-height:1.15;

    margin-bottom:15px;
}

.contact-box p{
    color:#cbd5e1;
}

.contact-list{
    display:grid;

    gap:14px;
}

.contact-item{
    padding:17px;

    background:
    rgba(255,255,255,.05);

    border:
    1px solid
    rgba(255,255,255,.12);

    border-radius:13px;
}

.contact-item strong{
    display:block;

    margin-bottom:3px;
}

.contact-item span{
    color:#cbd5e1;

    font-size:13px;
}

/* =========================================================
   CTA
========================================================= */

.cta{
    padding:70px 0;
}

.cta-box{
    padding:60px 30px;

    text-align:center;

    border:
    1px solid
    #bfdbfe;

    border-radius:25px;

    background:
    radial-gradient(
        circle at top right,
        #dbeafe,
        transparent 35%
    ),
    #eff6ff;
}

.cta-box h2{
    color:var(--secondary);

    font-size:38px;

    margin-bottom:10px;
}

.cta-box p{
    max-width:650px;

    margin:
    0 auto
    25px;

    color:var(--muted);
}

/* =========================================================
   FOOTER
========================================================= */

.footer{
    padding:60px 0 25px;

    background:#020617;

    color:#cbd5e1;
}

.footer-grid{
    display:grid;

    grid-template-columns:
    1.4fr
    1fr
    1fr
    1fr;

    gap:35px;

    padding-bottom:45px;
}

.footer h3{
    color:#ffffff;

    font-size:15px;

    margin-bottom:15px;
}

.footer p{
    color:#94a3b8;

    font-size:13px;
}

.footer a{
    display:block;

    color:#94a3b8;

    font-size:13px;

    margin:9px 0;

    transition:.2s;
}

.footer a:hover{
    color:#ffffff;
}

.footer-bottom{
    display:flex;

    justify-content:space-between;

    gap:20px;

    padding-top:22px;

    border-top:
    1px solid
    rgba(255,255,255,.1);

    color:#64748b;

    font-size:12px;
}

/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width:1000px){

    .nav-links{
        position:absolute;

        top:76px;

        left:0;
        right:0;

        display:none;

        flex-direction:column;

        align-items:stretch;

        padding:15px;

        background:#ffffff;

        border-bottom:
        1px solid
        var(--border);
    }

    .nav-links.show{
        display:flex;
    }

    .mobile-menu{
        display:block;
    }

    .hero-grid{
        grid-template-columns:1fr;
    }

    .database-grid{
        grid-template-columns:
        repeat(2,1fr);
    }

    .about-grid{
        grid-template-columns:1fr;
    }

    .contact-box{
        grid-template-columns:1fr;
    }

    .footer-grid{
        grid-template-columns:
        1fr 1fr;
    }
}

@media(max-width:650px){

    .hero{
        padding:70px 0;
    }

    .section{
        padding:65px 0;
    }

    .hero h1{
        letter-spacing:-2px;
    }

    .database-grid{
        grid-template-columns:1fr;
    }

    .features{
        grid-template-columns:1fr;
    }

    .contact-box{
        padding:35px 25px;
    }

    .contact-box h2{
        font-size:30px;
    }

    .about-content h2{
        font-size:32px;
    }

    .cta-box h2{
        font-size:30px;
    }

    .footer-grid{
        grid-template-columns:1fr;
    }

    .footer-bottom{
        flex-direction:column;
    }
}

</style>
</head>


