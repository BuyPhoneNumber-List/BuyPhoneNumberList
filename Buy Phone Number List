<!DOCTYPE html>
<html b:version='2' class='v2' expr:dir='data:blog.languageDirection'
      xmlns='http://www.w3.org/1999/xhtml'
      xmlns:b='http://www.google.com/2005/gml/b'
      xmlns:data='http://www.google.com/2005/gml/data'
      xmlns:expr='http://www.google.com/2005/gml/expr'>

<head>
  <meta charset='UTF-8'/>
  <meta content='width=device-width, initial-scale=1' name='viewport'/>

  <title>
    <data:blog.pageTitle/>
  </title>

  <meta content='Phone Number List, WhatsApp Number List, Telegram Number List and Email List' name='description'/>
  <meta content='phone number list, whatsapp number list, telegram number list, email list' name='keywords'/>

  <b:skin><![CDATA[

  *{
    margin:0;
    padding:0;
    box-sizing:border-box;
  }

  html{
    scroll-behavior:smooth;
  }

  body{
    font-family:Arial,Helvetica,sans-serif;
    background:#070b18;
    color:#e5e7eb;
    line-height:1.7;
  }

  a{
    color:inherit;
    text-decoration:none;
  }

  img{
    max-width:100%;
    height:auto;
  }

  .container{
    width:92%;
    max-width:1180px;
    margin:auto;
  }

  /* HEADER */

  .site-header{
    position:sticky;
    top:0;
    z-index:999;
    background:rgba(7,11,24,.94);
    border-bottom:1px solid rgba(255,255,255,.08);
    backdrop-filter:blur(15px);
  }

  .nav{
    min-height:74px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:30px;
  }

  .logo{
    font-size:25px;
    font-weight:800;
    letter-spacing:-.5px;
    color:#fff;
  }

  .logo span{
    color:#8b5cf6;
  }

  .menu{
    display:flex;
    align-items:center;
    gap:24px;
    list-style:none;
  }

  .menu a{
    color:#cbd5e1;
    font-size:14px;
    font-weight:600;
    transition:.25s;
  }

  .menu a:hover{
    color:#a78bfa;
  }

  .menu-btn{
    display:none;
    cursor:pointer;
    font-size:26px;
    color:#fff;
  }

  /* HERO */

  .hero{
    padding:100px 0 90px;
    background:
      radial-gradient(circle at 20% 20%,rgba(139,92,246,.20),transparent 35%),
      radial-gradient(circle at 80% 30%,rgba(6,182,212,.14),transparent 35%);
  }

  .hero-grid{
    display:grid;
    grid-template-columns:1.15fr .85fr;
    align-items:center;
    gap:60px;
  }

  .badge{
    display:inline-block;
    padding:7px 14px;
    border:1px solid rgba(139,92,246,.4);
    background:rgba(139,92,246,.10);
    color:#c4b5fd;
    border-radius:30px;
    font-size:13px;
    margin-bottom:20px;
  }

  .hero h1{
    font-size:58px;
    line-height:1.1;
    letter-spacing:-2px;
    color:#fff;
    margin-bottom:22px;
  }

  .hero h1 span{
    background:linear-gradient(90deg,#8b5cf6,#06b6d4);
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
  }

  .hero p{
    color:#94a3b8;
    font-size:18px;
    max-width:680px;
    margin-bottom:30px;
  }

  .buttons{
    display:flex;
    gap:15px;
    flex-wrap:wrap;
  }

  .btn{
    display:inline-block;
    padding:13px 22px;
    border-radius:10px;
    font-weight:700;
    transition:.25s;
  }

  .btn-primary{
    background:linear-gradient(90deg,#7c3aed,#0891b2);
    color:#fff;
  }

  .btn-primary:hover{
    transform:translateY(-2px);
    box-shadow:0 10px 30px rgba(124,58,237,.25);
  }

  .btn-outline{
    border:1px solid rgba(255,255,255,.15);
    color:#cbd5e1;
  }

  .btn-outline:hover{
    border-color:#8b5cf6;
    color:#fff;
  }

  .hero-card{
    padding:30px;
    border:1px solid rgba(255,255,255,.10);
    border-radius:22px;
    background:linear-gradient(145deg,rgba(255,255,255,.07),rgba(255,255,255,.025));
    box-shadow:0 30px 80px rgba(0,0,0,.35);
  }

  .hero-card h3{
    font-size:21px;
    margin-bottom:18px;
    color:#fff;
  }

  .data-row{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:15px 0;
    border-bottom:1px solid rgba(255,255,255,.07);
  }

  .data-row:last-child{
    border-bottom:0;
  }

  .data-name{
    color:#cbd5e1;
  }

  .data-number{
    color:#67e8f9;
    font-weight:700;
  }

  /* SECTIONS */

  .section{
    padding:85px 0;
  }

  .section-title{
    text-align:center;
    margin-bottom:45px;
  }

  .section-title h2{
    color:#fff;
    font-size:38px;
    margin-bottom:12px;
  }

  .section-title p{
    color:#94a3b8;
    max-width:650px;
    margin:auto;
  }

  /* CARDS */

  .cards{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:22px;
  }

  .card{
    padding:30px;
    border-radius:18px;
    background:#0d1325;
    border:1px solid rgba(255,255,255,.08);
    transition:.3s;
  }

  .card:hover{
    transform:translateY(-6px);
    border-color:rgba(139,92,246,.45);
    box-shadow:0 20px 50px rgba(0,0,0,.25);
  }

  .icon{
    width:52px;
    height:52px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:14px;
    background:rgba(139,92,246,.12);
    color:#a78bfa;
    font-size:23px;
    margin-bottom:20px;
  }

  .card h3{
    color:#fff;
    margin-bottom:10px;
    font-size:20px;
  }

  .card p{
    color:#94a3b8;
    font-size:15px;
  }

  /* ABOUT */

  .about{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:50px;
    align-items:center;
  }

  .about h2{
    font-size:40px;
    color:#fff;
    margin-bottom:18px;
  }

  .about p{
    color:#94a3b8;
    margin-bottom:15px;
  }

  .feature-list{
    list-style:none;
    margin-top:25px;
  }

  .feature-list li{
    margin-bottom:13px;
    color:#cbd5e1;
  }

  .feature-list li:before{
    content:'✓';
    color:#22d3ee;
    font-weight:bold;
    margin-right:10px;
  }

  .about-box{
    padding:40px;
    border-radius:22px;
    background:linear-gradient(145deg,#11182d,#0b1020);
    border:1px solid rgba(255,255,255,.08);
  }

  .about-box h3{
    color:#fff;
    font-size:25px;
    margin-bottom:18px;
  }

  /* FAQ */

  .faq{
    max-width:850px;
    margin:auto;
  }

  .faq-item{
    margin-bottom:14px;
    background:#0d1325;
    border:1px solid rgba(255,255,255,.08);
    border-radius:13px;
    overflow:hidden;
  }

  .faq-question{
    padding:20px;
    color:#fff;
    font-weight:700;
    cursor:pointer;
    position:relative;
    padding-right:55px;
  }

  .faq-question:after{
    content:'+';
    position:absolute;
    right:20px;
    top:15px;
    font-size:25px;
    color:#a78bfa;
  }

  .faq-answer{
    display:none;
    padding:0 20px 20px;
    color:#94a3b8;
  }

  .faq-item.active .faq-answer{
    display:block;
  }

  .faq-item.active .faq-question:after{
    content:'−';
  }

  /* CTA */

  .cta{
    padding:70px 30px;
    border-radius:25px;
    text-align:center;
    background:
      radial-gradient(circle at 20% 30%,rgba(139,92,246,.25),transparent 35%),
      radial-gradient(circle at 80% 70%,rgba(6,182,212,.18),transparent 35%),
      #0d1325;
    border:1px solid rgba(255,255,255,.08);
  }

  .cta h2{
    color:#fff;
    font-size:38px;
    margin-bottom:15px;
  }

  .cta p{
    color:#94a3b8;
    max-width:650px;
    margin:0 auto 25px;
  }

  /* BLOGGER POST */

  .main-wrapper{
    min-height:300px;
  }

  .blog-posts{
    width:100%;
  }

  .post{
    background:#0d1325;
    padding:30px;
    margin-bottom:25px;
    border-radius:18px;
    border:1px solid rgba(255,255,255,.08);
  }

  .post-title{
    color:#fff;
    font-size:30px;
    margin-bottom:15px;
  }

  .post-body{
    color:#cbd5e1;
  }

  .post-body a{
    color:#67e8f9;
  }

  .post-labels a{
    color:#a78bfa;
  }

  /* FOOTER */

  footer{
    margin-top:80px;
    padding:55px 0 25px;
    border-top:1px solid rgba(255,255,255,.08);
    background:#050812;
  }

  .footer-grid{
    display:grid;
    grid-template-columns:2fr 1fr 1fr;
    gap:40px;
    margin-bottom:45px;
  }

  footer h3{
    color:#fff;
    margin-bottom:15px;
  }

  footer p,
  footer li,
  footer a{
    color:#64748b;
    font-size:14px;
  }

  footer ul{
    list-style:none;
  }

  footer li{
    margin-bottom:9px;
  }

  footer a:hover{
    color:#a78bfa;
  }

  .copyright{
    padding-top:25px;
    border-top:1px solid rgba(255,255,255,.06);
    text-align:center;
    color:#475569;
    font-size:13px;
  }

  /* RESPONSIVE */

  @media(max-width:900px){

    .menu-btn{
      display:block;
    }

    .menu{
      display:none;
      position:absolute;
      left:0;
      right:0;
      top:74px;
      padding:20px;
      flex-direction:column;
      align-items:flex-start;
      background:#080d1d;
      border-bottom:1px solid rgba(255,255,255,.08);
    }

    .menu.show{
      display:flex;
    }

    .hero-grid,
    .about{
      grid-template-columns:1fr;
    }

    .hero h1{
      font-size:43px;
    }

    .cards{
      grid-template-columns:1fr 1fr;
    }

    .footer-grid{
      grid-template-columns:1fr 1fr;
    }

  }

  @media(max-width:600px){

    .container{
      width:90%;
    }

    .hero{
      padding:70px 0;
    }

    .hero h1{
      font-size:36px;
    }

    .hero p{
      font-size:16px;
    }

    .section{
      padding:65px 0;
    }

    .section-title h2,
    .about h2,
    .cta h2{
      font-size:30px;
    }

    .cards{
      grid-template-columns:1fr;
    }

    .footer-grid{
      grid-template-columns:1fr;
    }

    .hero-card{
      padding:22px;
    }

  }

  ]]></b:skin>
</head>

<body>

  <!-- HEADER -->

  <header class='site-header'>
    <div class='container nav'>

